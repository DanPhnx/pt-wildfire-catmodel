# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Raw data: snapshot CSVs are committed for reproducibility (see 01_eda.ipynb),
# anything else fetched into data/raw/ is not
data/raw/*
!data/raw/.gitkeep
!data/raw/effis_annual_fire_counts.csv
!data/raw/gwis_annual_burnt_area.csv
!data/raw/annual_loss_calibration.csv

# Processed data is derived and regenerable from the committed raw snapshot, not versioned
data/processed/*
!data/processed/.gitkeep

# Simulation output
simulation/*.csv
!simulation/.gitkeep
